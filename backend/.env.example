PORT=5000
NODE_ENV=development

# Local MongoDB for development. Swap to an Atlas SRV URI for production
# (e.g. mongodb+srv://user:pass@cluster.mongodb.net/todays-special) with no code changes.
MONGODB_URI=mongodb://127.0.0.1:27017/todays-special

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Base URL the media service uses to build absolute mediaUrl values returned to clients.
MEDIA_BASE_URL=http://localhost:5000

# Comma-separated list of origins allowed by CORS (manager dashboard, TV player).
FRONTEND_URL=http://localhost:5173

# Used only by `npm run seed:admin` to provision/update the dashboard admin account.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
