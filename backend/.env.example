PORT=5000
NODE_ENV=development

# Local MongoDB for development. Swap to an Atlas SRV URI for production
# (e.g. mongodb+srv://user:pass@cluster.mongodb.net/todays-special) with no code changes.
MONGODB_URI=mongodb://127.0.0.1:27017/todays-special

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Base URL the media service uses to build absolute mediaUrl values returned to clients.
MEDIA_BASE_URL=http://localhost:5000

# Comma-separated list of origins allowed by CORS (manager dashboard, TV player).
FRONTEND_URL=http://localhost:5173

# Used only by `npm run seed:admin` to provision/update the dashboard admin account.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional. Leave all three blank for local dev — uploaded media is then
# stored on local disk under uploads/ as before. Set all three (production)
# to persist final images/videos to Cloudinary instead, since most hosts'
# filesystems are wiped on restart/redeploy. Get these from your Cloudinary
# dashboard's "Account Details" panel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
